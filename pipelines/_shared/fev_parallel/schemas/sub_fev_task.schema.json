{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "fev_parallel/sub_fev_task.schema.json",
  "title": "FEV 1.2.0 Sub-FEV Parallel Task",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "root_fev",
    "sub_fev",
    "agent",
    "question",
    "write_scope",
    "resources",
    "run_id",
    "state"
  ],
  "properties": {
    "root_fev": { "type": "string", "minLength": 1 },
    "sub_fev": { "type": "string", "minLength": 1 },
    "parent_fev": { "type": "string" },
    "agent": { "type": "string", "minLength": 1 },
    "question": { "type": "string", "minLength": 1 },
    "hypothesis": { "type": "string" },
    "write_scope": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "resources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["resource_id", "lease_kind"],
        "properties": {
          "resource_id": { "type": "string" },
          "lease_kind": {
            "type": "string",
            "enum": ["tool", "transaction", "exclusive"]
          }
        }
      }
    },
    "depends_on": {
      "type": "array",
      "items": { "type": "string" }
    },
    "run_id": { "type": "string", "minLength": 1 },
    "evidence_root": { "type": "string" },
    "state": {
      "type": "string",
      "enum": [
        "PROPOSED",
        "READY",
        "RUNNING",
        "WAITING_RESOURCE",
        "EVIDENCE_READY",
        "LOCAL_VERDICT",
        "AGGREGATED",
        "BLOCKED",
        "INCONCLUSIVE",
        "CANCELLED",
        "FAILED_EXECUTION"
      ]
    },
    "local_verdict": {
      "type": "string",
      "enum": [
        "FEASIBLE",
        "NOT_FEASIBLE",
        "PARTIALLY_FEASIBLE",
        "BLOCKED",
        "INCONCLUSIVE"
      ]
    }
  }
}
